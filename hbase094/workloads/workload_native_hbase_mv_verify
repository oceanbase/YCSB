# Small multi-version load for verification (3 rows, 5 versions per qualifier).

workload=site.ycsb.workloads.CoreWorkload

recordcount=3
operationcount=3
fieldcount=10
fieldlength=20

insertproportion=1
readproportion=0
updateproportion=0
scanproportion=0
batchput.size.per.op=1

insertorder=ordered
requestdistribution=uniform
threadcount=1

table=ycsb_mv_verify
columnfamily=v

hbase.zookeeper.quorum=<zk_host1>,<zk_host2>,<zk_host3>
hbase.zookeeper.property.clientPort=2181
hbase.master=<hmaster_host>:60000

hbase.versionsPerQualifier=5
hbase.versionDeltaMs=1000
hbase.versionAnchorTs=1767225600000
hbase.versionSpreadInWindow=true
hbase.versionWindowMs=15552000000

clientbuffering=false
debug=true

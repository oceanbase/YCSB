{
  "moduleId": "obkv-table",
  "displayName": "OBKV Table",
  "jarPathConfig": "webui.table.jar.path",
  "workdirConfig": "webui.table.workdir",
  "commandFlags": ["-s"],
  "loadFlag": "-load",

  "connectionModes": {
    "odp": {
      "fields": [
        {"key": "obkv.odpAddr", "label": "ODP 地址", "type": "text", "required": true},
        {"key": "obkv.odpPort", "label": "ODP 端口", "type": "number", "required": true, "defaultValue": "2883"}
      ]
    },
    "direct": {
      "fields": [
        {"key": "obkv.configUrl",    "label": "Config url",  "type": "text",     "required": true},
        {"key": "obkv.sysUserName",  "label": "系统租户用户名",  "type": "text",     "required": true},
        {"key": "obkv.sysPassword",  "label": "系统租户密码",    "type": "password", "required": true}
      ]
    },
    "common": {
      "fields": [
        {"key": "obkv.odpMode",      "label": "ODP 模式",  "type": "hidden",   "defaultValue": "false"},
        {"key": "obkv.fullUserName", "label": "测试租户用户名", "type": "text",     "required": true},
        {"key": "obkv.password",     "label": "测试租户密码",      "type": "password", "required": true},
        {"key": "obkv.database",     "label": "数据库",    "type": "text",     "required": true, "defaultValue": "test"},
        {"key": "table",             "label": "表名",      "type": "text",     "required": true, "defaultValue": "kv_table"}
      ]
    }
  },

  "tableModes": [
    {
      "id": "default",
      "label": "默认模式",
      "fields": [],
      "dbClass": "com.oceanbase.obkv.table.ycsb.ObTableClientDB"
    },
    {
      "id": "prefix",
      "label": "前缀模式",
      "fields": [
        {"key": "obkv.prefixCount",             "label": "前缀数量",        "type": "number", "required": true},
        {"key": "obkv.rangePartitionStartTs",   "label": "起始时间戳(ms)",  "type": "number", "required": true},
        {"key": "obkv.rangePartitionDurationMs","label": "分区时长(ms)",    "type": "number", "required": true},
        {"key": "obkv.rangePartitionCount",     "label": "Range 分区数",    "type": "number", "required": true}
      ],
      "dbClass": "com.oceanbase.obkv.table.ycsb.ObTableClientDBRK"
    }
  ],

  "partitionTypes": [],

  "testTypes": [
    {
      "id": "load",
      "label": "load",
      "isLoad": true,
      "proportions": {"insertproportion": 1},
      "extraFields": [
        {"key": "obkv.insertType", "label": "写入类型", "type": "select", "options": ["put", "insert", "insertup"], "defaultValue": "put"}
      ]
    },
    {
      "id": "put",
      "label": "put",
      "isLoad": false,
      "proportions": {"insertproportion": 1},
      "extraFields": [
        {"key": "obkv.insertType", "label": "写入类型", "type": "select", "options": ["put", "insert", "insertup"], "defaultValue": "put"}
      ]
    },
    {
      "id": "read",
      "label": "read",
      "isLoad": false,
      "proportions": {"readproportion": 1},
      "extraFields": [
        {"key": "obkv.insertType", "label": "写入类型", "type": "select", "options": ["put", "insert", "insertup"], "defaultValue": "put"}
      ]
    },
    {
      "id": "scan",
      "label": "scan",
      "isLoad": false,
      "proportions": {"scanproportion": 1},
      "extraFields": [
        {"key": "maxscanlength",          "label": "最大扫描行数", "type": "number", "defaultValue": "1000"},
        {"key": "scanlengthdistribution", "label": "扫描长度分布", "type": "text",   "defaultValue": "uniform"},
        {"key": "obkv.insertType", "label": "写入类型", "type": "select", "options": ["put", "insert", "insertup"], "defaultValue": "put"}
      ]
    },
    {
      "id": "update",
      "label": "update",
      "isLoad": false,
      "proportions": {"updateproportion": 1},
      "extraFields": [
        {"key": "obkv.insertType", "label": "写入类型", "type": "select", "options": ["put", "insert", "insertup"], "defaultValue": "put"}
      ]
    },
    {
      "id": "batch_put",
      "label": "batch_put",
      "isLoad": false,
      "proportions": {"batchputproportion": 1},
      "extraFields": [
        {"key": "batchput.size.per.op",  "label": "每批次大小", "type": "number", "defaultValue": "10"},
        {"key": "obkv.insertType", "label": "写入类型", "type": "select", "options": ["put", "insert", "insertup"], "defaultValue": "put"}
      ]
    },
    {
      "id": "batch_read",
      "label": "batch_read",
      "isLoad": false,
      "proportions": {"batchreadproportion": 1},
      "extraFields": [
        {"key": "batchread.size.per.op", "label": "每批次大小", "type": "number", "defaultValue": "10"},
        {"key": "obkv.insertType", "label": "写入类型", "type": "select", "options": ["put", "insert", "insertup"], "defaultValue": "put"}
      ]
    }
  ],

  "knownParams": [
    "obkv.odpMode",
    "obkv.odpAddr",
    "obkv.odpPort",
    "obkv.configUrl",
    "obkv.sysUserName",
    "obkv.sysPassword",
    "obkv.fullUserName",
    "obkv.password",
    "obkv.database",
    "table",
    "obkv.tableMode",
    "obkv.prefixCount",
    "obkv.rangePartitionStartTs",
    "obkv.rangePartitionDurationMs",
    "obkv.rangePartitionCount",
    "obkv.maxKey",
    "obkv.debug",
    "obkv.insertType",
    "obkv.updateType",
    "obkv.batchPutType",
    "insertorder",
    "maxscanlength",
    "scanlengthdistribution",
    "batchput.size.per.op",
    "batchread.size.per.op",
    "server.connection.pool.size",
    "rpc.operation.timeout",
    "rpc.execute.timeout",
    "workload",
    "recordcount",
    "operationcount",
    "threadcount",
    "fieldcount",
    "fieldlength",
    "requestdistribution",
    "readproportion",
    "insertproportion",
    "scanproportion",
    "updateproportion",
    "readmodifywriteproportion",
    "batchputproportion",
    "batchreadproportion",
    "measurementtype"
  ]
}

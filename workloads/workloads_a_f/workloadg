# Yahoo! Cloud System Benchmark
# Workload G: Custom workload
#   Application example: User-defined custom test scenarios
#                        
#   Read/update/scan/insert ratio: Configurable via console
#   Default: 25% Read / 25% Update / 25% Scan / 25% Insert
#   Default data size: 1 KB records (10 fields, 100 bytes each, plus key)
#   Request distribution: zipfian

recordcount=1000
operationcount=1000
workload=site.ycsb.workloads.CoreWorkload

readallfields=true

readproportion=0.25
updateproportion=0.25
scanproportion=0.25
insertproportion=0.25

requestdistribution=zipfian

# Scan length distribution (for scan operations)
maxscanlength=100
scanlengthdistribution=uniform

